# --- 密钥绝不入库 ---
.env
.env.*
!.env.example

# --- 输入文档不入库 ---
# 输入是真实文件：GB/T 1568 取自官方公开预览（不再分发）。
# 复现方式见 README 与 docs/troubleshooting.md。
data/raw/

# --- 中间产物不入库 ---
# 中间产物；入库的是 data/golden/ 与 artifacts/ 下的溯源链。
data/derived/
out/

# --- 本地工具 / 临时目录不入库 ---
# 沙箱里没有系统 PATH 依赖时用到的本地工具与运行包装脚本；
# 换机器重装即可，不构成项目的一部分。
.tmprun/
.tools/
.pytest-tmp/
# uv 的本地缓存目录。
#
# 它此前**没有**出现在这里，只是碰巧没被跟踪：`uv` 在该目录里自带一份
# `.gitignore`（内容就是 `*`），于是 git 看不见它。但那份文件住在缓存目录
# **内部**——`uv cache clean` 或换台机器重建目录时它就不在了，
# 届时 `git status` 会突然多出几万个文件。防护措施不该依赖被防护对象本身。
.uvcache/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# --- 编辑器 / 系统 ---
.vscode/
.idea/
Thumbs.db
desktop.ini