# 复制本文件为 .env 并填入真实值。.env 已在 .gitignore 中，不会被提交。
#
#     Copy-Item .env.example .env      # Windows PowerShell
#     cp .env.example .env             # bash
#
# 这里只放**变量名**。任何真实密钥都不要写进本文件、不要写进 config/*.yaml、
# 更不要提交。配置层只按变量名引用密钥（见 src/docqa/config.py）。
#
# 不知道该填什么？先跑 `docqa doctor`，它会告诉你缺哪个、影响哪一步。

# ============================================================
# 一、OCR 视觉模型（必需 —— 没有它就无法解析扫描件）
# ============================================================
# 扫描件没有文本层，必须用支持图像输入的模型来识别。选一个填即可。

# --- 方案 A：OpenAI 兼容接口（推荐，覆盖面最广）---
# 适用于通义千问 / 智谱 / Kimi / OpenAI / vLLM / Ollama / LM Studio 等
# 任何提供 OpenAI 兼容 /chat/completions 的服务。
#
# 只需填 4 行：PROVIDER / BASE_URL / API_KEY / MODEL。
# 下面的对照表是常见写法，**以各家文档为准**；填完务必跑 `docqa doctor`，
# 它会用一张合成测试图**实测**这个模型到底看不看得见图。
#
#   ┌──────────┬──────────────────────────────────────────────┬───────────────────────┐
#   │ 供应商   │ BASE_URL                                     │ MODEL（须支持图像）   │
#   ├──────────┼──────────────────────────────────────────────┼───────────────────────┤
#   │ 通义千问 │ https://dashscope.aliyuncs.com/compatible-mode/v1 │ qwen-vl-ocr      │
#   │ 智谱     │ https://open.bigmodel.cn/api/paas/v4         │ glm-4v-plus           │
#   │ 月之暗面 │ https://api.moonshot.cn/v1                   │ moonshot-v1-8k-vision-preview │
#   │ OpenAI   │ https://api.openai.com/v1                    │ gpt-4o                │
#   │ 本地 Ollama │ http://localhost:11434/v1                 │ qwen2.5vl:7b          │
#   └──────────┴──────────────────────────────────────────────┴───────────────────────┘
#
# **关于 DeepSeek**：其视觉模型 `deepseek-v4-flash-vision-exp` 于 2026-08-21
# 上线，走 api.deepseek.com，OpenAI 兼容格式，所以本适配器可以直接用：
#     DOCQA_OCR_BASE_URL=https://api.deepseek.com/v1
#     DOCQA_OCR_MODEL=deepseek-v4-flash-vision-exp
#
# 但有两点必须先实测，不要假设可用：
#   1) 有报告称该端点曾对所有图片请求返回 400
#      （unknown variant 'image_url'）。`docqa doctor` 30 秒验明。
#   2) 单图约 384 tokens、图像被缩到 800×800 等效。对密集小字的扫描件
#      （如 A4 国标页图 2315×3274）**分辨率可能不够**——
#      能不能调通是一回事，识别得对不对是另一回事，要人眼核对。
#
# 这也是为什么 `doctor` 发的是真图、而不是只检查"配置填了没"：
# 纯文本模型遇到图片会**静默忽略**、返回看似合理的文字，不报错但内容是编的。
#
# 表格类文档优先选**专用 OCR 模型**（如 qwen-vl-ocr）而不是通用多模态模型：
# 在中文表格结构上，专用小模型的准确率明显更高，单价也低得多。

DOCQA_OCR_PROVIDER=openai
DOCQA_OCR_BASE_URL=
DOCQA_OCR_API_KEY=
DOCQA_OCR_MODEL=
# 可留空。留空即视为 true；真正说了算的是 `docqa doctor` 的实测结果。
DOCQA_OCR_SUPPORTS_VISION=

# --- 方案 B：Anthropic Messages API ---
# DOCQA_OCR_PROVIDER=anthropic
# DOCQA_OCR_API_KEY=
# DOCQA_OCR_MODEL=claude-opus-5

# ============================================================
# 二、生成模型（可选 —— 不配则自动降级为"仅检索 + 抽取式回答"）
# ============================================================
# 不配置也能跑通检索、引用、自检与评估；只是答案由证据片段抽取拼装，
# 不做语言组织。详见 src/docqa/llm/null.py。

DOCQA_LLM_PROVIDER=openai
DOCQA_LLM_BASE_URL=
DOCQA_LLM_API_KEY=
DOCQA_LLM_MODEL=

# DOCQA_LLM_PROVIDER=anthropic
# DOCQA_LLM_API_KEY=
# DOCQA_LLM_MODEL=claude-opus-5

# ============================================================
# 三、可比对的第二个 OCR 引擎（可选 —— 用于跨引擎一致性校验）
# ============================================================
# 同一页用两个不同来源的引擎各识别一次，逐块比对，不一致处标 needs_review。
# 这不是"多数投票"，而是为了让"低置信度"这个标记**可被评估**（见 docs/evaluation.md）。
# 留空则跳过交叉校验，并在报告里如实标注该项缺失。

DOCQA_OCR2_PROVIDER=
DOCQA_OCR2_BASE_URL=
DOCQA_OCR2_API_KEY=
DOCQA_OCR2_MODEL=

# ============================================================
# 四、行为开关（都有合理默认值，通常不用改）
# ============================================================

# 日志级别：DEBUG / INFO / WARNING / ERROR
DOCQA_LOG_LEVEL=INFO

# 注意：日志层**不做任何密钥打码**——密钥绝不允许出现在日志调用里。
# 这条纪律由 tests/test_no_secrets_in_logs.py 守住。

# 网络调用超时（秒）与最大重试次数（仅对限流与 5xx 重试）
DOCQA_HTTP_TIMEOUT=120
DOCQA_HTTP_MAX_RETRIES=3
